# Web (apps/web) — read at build time by Vite
# mock (default): MSW serves the API in the browser. live: services/tenant-api at VITE_API_URL.
VITE_API_MODE=mock
VITE_API_URL=http://localhost:8080/api/v1
# mock (default): fixture extractions for the sample receipts. live: calls VITE_AI_URL.
VITE_AI_MODE=mock
VITE_AI_URL=http://localhost:8000

# AI service (services/ai) — never commit real values.
# Without ANTHROPIC_API_KEY the SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. M6 evals compare models (e.g. claude-haiku-5-5).
MODEL_ID=claude-opus-5-5
# low | medium | high | xhigh | max. Extraction is a short task: low is fast and cheap.
EFFORT=low
# A file in services/ai/app/extraction/prompts/
PROMPT_VERSION=v1
MAX_IMAGE_BYTES=5000000
MAX_IMAGE_SIDE=1568
CORS_ORIGINS=["http://localhost:5173"]

# Tenant API (services/tenant-api, Spring Boot) — local Docker Compose defaults, not secrets.
DB_URL=jdbc:mysql://localhost:3307/outlay?connectionTimeZone=UTC&forceConnectionTimeMapping=true
DB_USER=outlay
DB_PASSWORD=outlay
# The `demo` profile turns on X-Demo-Persona authentication, /demo endpoints and seed data.
SPRING_PROFILES_ACTIVE=demo
# Comma-separated origins allowed by CORS (the web app's dev and preview servers).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4174

# Live demo on a VM (compose.prod.yaml, docs/DEPLOY.md). Set real values in the VM's .env.
SITE_ADDRESS=demo.example.com
DB_ROOT_PASSWORD=change-me
RESET_EVERY_SECONDS=3600
