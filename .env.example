# Web (apps/web) — read at build time by Vite
# mock (default): MSW serves the API in the browser. live: real backend (phase 2).
VITE_API_MODE=mock
# mock (default): fixture extractions. live: calls VITE_AI_URL.
VITE_AI_MODE=mock
VITE_AI_URL=http://localhost:8000

# AI service (services/ai) — never commit real values
ANTHROPIC_API_KEY=
MODEL_ID=
PROMPT_VERSION=v1
