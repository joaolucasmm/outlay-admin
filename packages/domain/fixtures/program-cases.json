            "code": "TRAVEL",
            "name": "Travel",
            "glAccount": "6200",
            "active": true
          },
          {
            "id": "cat_bluefin_lodging",
            "tenantId": "tnt_bluefin",
            "code": "LODGING",
            "name": "Lodging",
            "glAccount": "6210",
            "active": true
          },
